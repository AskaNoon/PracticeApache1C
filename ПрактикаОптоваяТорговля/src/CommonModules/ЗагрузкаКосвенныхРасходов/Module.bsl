Процедура ЗагрузитьНаСервере(ДвоичныеДанные, АдресРезультата) Экспорт

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВременногоФайла);

	КоличествоЗаписей = 0;
	ОбработанныеМесяцы = Новый Соответствие;

	Пока ЧтениеXML.Прочитать() Цикл

		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
			И ЧтениеXML.Имя = "Расход" Тогда

			МесяцСтрокой = "";
			НаименованиеСтатьи = "";
			Сумма = 0;

			Пока ЧтениеXML.Прочитать() Цикл
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента
					И ЧтениеXML.Имя = "Расход" Тогда
					Прервать;
				КонецЕсли;

				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
					ИмяПоля = ЧтениеXML.Имя;
					Если ЧтениеXML.Прочитать()
						И ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
						Если ИмяПоля = "Месяц" Тогда
							МесяцСтрокой = ЧтениеXML.Значение;
						ИначеЕсли ИмяПоля = "Статья" Тогда
							НаименованиеСтатьи = ЧтениеXML.Значение;
						ИначеЕсли ИмяПоля = "Сумма" Тогда
							Сумма = Число(ЧтениеXML.Значение);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			// Сопоставление статьи расходов
			Статья = Справочники.СтатьиРасходов.НайтиПоНаименованию(НаименованиеСтатьи);
			Если Статья.Пустая() Тогда
				ВызватьИсключение "Не найдена статья расходов: """ + НаименованиеСтатьи + """";
			КонецЕсли;

			// Поиск или создание документа за месяц
			МесяцДокумента = НачалоМесяца(XMLЗначение(Тип("Дата"), МесяцСтрокой));
			СуществующийДокумент = НайтиДокументЗаМесяц(МесяцДокумента);

			Если СуществующийДокумент = Неопределено Тогда
				ДокументОбъект = Документы.КосвенныеРасходы.СоздатьДокумент();
				ДокументОбъект.Дата = ТекущаяДатаСеанса();
			Иначе
				ДокументОбъект = СуществующийДокумент.ПолучитьОбъект();
				// Очищаем строки только при первом обращении к месяцу в этой загрузке
				Если ОбработанныеМесяцы[МесяцДокумента] = Неопределено Тогда
					ДокументОбъект.СписокРасходов.Очистить();
				КонецЕсли;
			КонецЕсли;

			ДокументОбъект.Месяц = МесяцДокумента;
			НоваяСтрока = ДокументОбъект.СписокРасходов.Добавить();
			НоваяСтрока.СтатьяРасходов = Статья;
			НоваяСтрока.Сумма = Сумма;
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

			ОбработанныеМесяцы.Вставить(МесяцДокумента, Истина);
			КоличествоЗаписей = КоличествоЗаписей + 1;

		КонецЕсли;

	КонецЦикла;

	ЧтениеXML.Закрыть();

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Очистит платформа
	КонецПопытки;

	ПоместитьВоВременноеХранилище(КоличествоЗаписей, АдресРезультата);

КонецПроцедуры

Функция НайтиДокументЗаМесяц(Месяц)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КосвенныеРасходы.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.КосвенныеРасходы КАК КосвенныеРасходы
		|ГДЕ
		|	КосвенныеРасходы.Месяц = &Месяц");
	Запрос.УстановитьПараметр("Месяц", Месяц);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	Возврат Неопределено;

КонецФункции