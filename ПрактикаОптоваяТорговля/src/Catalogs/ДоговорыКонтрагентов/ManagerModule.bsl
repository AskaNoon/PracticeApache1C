Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Наименование");
	Поля.Добавить("ДатаНачала");
	Поля.Добавить("ДатаОкончания");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Данные.ДатаНачала = Дата(1, 1, 1)
		Или Данные.ДатаОкончания = Дата(1, 1, 1) Тогда
		Представление = Строка(Данные.Наименование);
		Возврат;
	КонецЕсли;

	// Целый месячный период: "<Наименование> (<Месяц Год>)"
	Если НачалоМесяца(Данные.ДатаНачала) = Данные.ДатаНачала
		И КонецМесяца(Данные.ДатаНачала) = КонецДня(Данные.ДатаОкончания)
		И НачалоМесяца(Данные.ДатаНачала) = НачалоМесяца(Данные.ДатаОкончания) Тогда
		ТекстМесяца = Формат(Данные.ДатаНачала, "ДФ='MMMM yyyy'");
		Представление = СтрШаблон("%1 (%2)", Данные.Наименование, ТекстМесяца);
	Иначе
		ПредставлениеПериода = СтрШаблон("с %1 по %2",
			Формат(Данные.ДатаНачала, "ДЛФ=D"),
			Формат(Данные.ДатаОкончания, "ДЛФ=D"));
		Представление = СтрШаблон("%1 (%2)", Данные.Наименование, ПредставлениеПериода);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	ТекущаяДата = ТекущаяДатаСеанса();		
	ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка,
		|	ПРЕДСТАВЛЕНИЕ(ДоговорыКонтрагентов.Ссылка) КАК Представление
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	ДоговорыКонтрагентов.ДатаНачала <= &ТекущаяДата
		|	И ДоговорыКонтрагентов.ДатаОкончания >= &ТекущаяДата";

	// Учёт отбора по виду договора (если он передан)
	ОтборПоВиду = Ложь;
	Если Параметры.Свойство("Отбор")
		И Параметры.Отбор.Свойство("ВидДоговора") Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
		ОтборПоВиду = Истина;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);
	Если ОтборПоВиду Тогда
		Запрос.УстановитьПараметр("ВидДоговора", Параметры.Отбор.ВидДоговора);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();

	ДанныеВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
	ДанныеВыбора.Добавить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;

КонецПроцедуры