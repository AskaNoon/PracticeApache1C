#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ЭтоАдресВременногоХранилища(АдресКартинки) Тогда
		ДанныеКартинки = ПолучитьИзВременногоХранилища(АдресКартинки);
		ТекущийОбъект.Изображение = Новый ХранилищеЗначения(ДанныеКартинки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	АдресКартинки = ПолучитьНавигационнуюСсылку(Объект.Ссылка, "Изображение");

КонецПроцедуры

#КонецОбласти
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура АдресКартинкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ВыбратьКартинку();

КонецПроцедуры

#КонецОбласти
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Очистить(Команда)

	АдресКартинки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

КонецПроцедуры


&НаКлиенте
Асинх Процедура ВставитьИзБуфера(Команда)

	Если НЕ СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Работа с буфером обмена недоступна в текущем клиенте";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ФорматКартинка = СтандартныйФорматДанныхБуфераОбмена.Картинка;

	Если НЕ Ждать СредстваБуфераОбмена.СодержитДанныеАсинх(ФорматКартинка) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "В буфере обмена нет изображения";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ДанныеБуфера = Ждать СредстваБуфераОбмена.ПолучитьДанныеАсинх(ФорматКартинка);
	ДвоичныеДанные = ДанныеБуфера.ПолучитьДвоичныеДанные();

	АдресКартинки = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);

КонецПроцедуры

&НаКлиенте
Асинх Процедура КопироватьВБуфер(Команда)

	Если НЕ СредстваБуфераОбмена.ИспользованиеДоступно() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Работа с буфером обмена недоступна в текущем клиенте";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	ДвоичныеДанные = ПолучитьДвоичныеДанныеИзображенияНаСервере(Объект.Ссылка);

	Если ДвоичныеДанные = Неопределено Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "У элемента нет изображения";
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	// Для формата "Картинка" нужен объект Картинка, а не "сырые" двоичные данные
	Картинка = Новый Картинка(ДвоичныеДанные);

	ФорматКартинка = СтандартныйФорматДанныхБуфераОбмена.Картинка;
	ЭлементБуфера = Новый ЭлементБуфераОбмена(ФорматКартинка, Картинка);

	ДанныеДляВставки = Новый Массив;
	ДанныеДляВставки.Добавить(ЭлементБуфера);

	Ждать СредстваБуфераОбмена.ПоместитьДанныеАсинх(ДанныеДляВставки);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДвоичныеДанныеИзображенияНаСервере(Номенклатура)

	Изображение = Номенклатура.Изображение.Получить();
	Возврат Изображение;

КонецФункции
#КонецОбласти
#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Асинх Процедура ВыбратьКартинку()

	ПараметрыПомещения = Новый ПараметрыДиалогаПомещенияФайлов();
	ПараметрыПомещения.Фильтр = "Картинка|*.png; *.jpeg; *.jpg";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыПомещения, УникальныйИдентификатор);

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресКартинки = Результат.Адрес;

КонецПроцедуры

#КонецОбласти