&НаКлиенте
Перем ДлительнаяОперация;
&НаКлиенте
Асинх Процедура ЗагрузитьИзXML(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл XML|*.xml";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);

	Если Результат = Неопределено
		Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = Результат.Адрес;

	// Запуск фонового задания
	ДлительнаяОперация = ЗапуститьЗагрузкуНаСервере(АдресФайла);

	Элементы.СтатусОперации.Заголовок = "Выполняется…";

	// Опрос состояния каждые 2 секунды
	ПодключитьОбработчикОжидания("ПроверитьРезультатЗагрузки", 2);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРезультатЗагрузки() Экспорт

	СостояниеОперации = СостояниеЗадания(ДлительнаяОперация);

	Если СостояниеОперации = "Выполняется" Тогда
		Возврат; // обработчик вызовется снова через 2 секунды
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьРезультатЗагрузки");

	Если СостояниеОперации = "Ошибка" Тогда
		Элементы.СтатусОперации.Заголовок = "Ошибка при загрузке";
		Возврат;
	КонецЕсли;

	КоличествоЗаписей = ПолучитьИзВременногоХранилища(ДлительнаяОперация.АдресРезультата);
	Элементы.СтатусОперации.Заголовок = "Загружено записей: " + Строка(КоличествоЗаписей);

КонецПроцедуры

&НаСервере
Функция ЗапуститьЗагрузкуНаСервере(АдресФайла)

	Результат = Новый Структура("ИдентификаторЗадания, АдресРезультата");

	// Заранее создаём адрес, в который задание запишет результат
	Результат.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПолучитьИзВременногоХранилища(АдресФайла));
	ПараметрыЗадания.Добавить(Результат.АдресРезультата);

	ФоновоеЗадание = ФоновыеЗадания.Выполнить(
		"ЗагрузкаКосвенныхРасходов.ЗагрузитьНаСервере",
		ПараметрыЗадания);

	Результат.ИдентификаторЗадания = ФоновоеЗадание.УникальныйИдентификатор;

	Возврат Результат;

КонецФункции

&НаСервере
Функция СостояниеЗадания(ДлительнаяОперация)

	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(
		ДлительнаяОперация.ИдентификаторЗадания);

	Если ФоновоеЗадание = Неопределено Тогда
		Возврат "Ошибка";
	КонецЕсли;

	Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "Выполняется";
	КонецЕсли;

	Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно
		Или ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Возврат "Ошибка";
	КонецЕсли;

	Возврат "Выполнено";

КонецФункции
