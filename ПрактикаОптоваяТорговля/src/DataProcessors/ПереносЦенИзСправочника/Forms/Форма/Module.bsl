#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиЦены(Команда)

	ПеренестиЦеныНаСервере();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПеренестиЦеныНаСервере()

	// Создаём один документ, в который поместим все начальные цены
	НовыйДокумент = Документы.УстановкаЦен.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	НовыйДокумент.Комментарий = "Начальные цены";

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Номенклатура,
		|	Номенклатура.УдалитьЦена КАК Цена
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.УдалитьЦена > 0";

	Выборка = Запрос.Выполнить().Выбрать();

	// Заполняем табличную часть документа всеми позициями из справочника
	Пока Выборка.Следующий() Цикл

		НоваяСтрока = НовыйДокумент.Цены.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Цена = Выборка.Цена;

	КонецЦикла;

	// Записываем и проводим документ один раз — после того, как табличная часть полностью заполнена
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);

КонецПроцедуры

#КонецОбласти
