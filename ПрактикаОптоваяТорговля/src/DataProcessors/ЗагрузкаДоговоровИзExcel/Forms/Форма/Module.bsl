
&НаКлиенте
Асинх Процедура ЗагрузитьВБазу(Команда)

	КоличествоНовых = ПолучитьКоличествоНовыхКонтрагентовНаСервере();

	Если КоличествоНовых > 0 Тогда
		ТекстВопроса = "Будет создано " + КоличествоНовых + " новых контрагентов. Продолжить?";
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗагрузитьВБазуНаСервере();

КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоНовыхКонтрагентовНаСервере()

	// Считаем уникальные новые названия, чтобы один и тот же
	// контрагент в нескольких строках не посчитался дважды
	Новые = Новый Соответствие;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаДанных.НаименованиеКонтрагента);
		Если Контрагент.Пустая() Тогда
			Новые.Вставить(СтрокаДанных.НаименованиеКонтрагента, Истина);
		КонецЕсли;
	КонецЦикла;

	Возврат Новые.Количество();

КонецФункции

&НаСервере
Процедура ЗагрузитьВБазуНаСервере()

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		// 1. Найти или создать контрагента
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(СтрокаДанных.НаименованиеКонтрагента);

		Если Контрагент.Пустая() Тогда
			НовыйКонтрагент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйКонтрагент.Наименование = СтрокаДанных.НаименованиеКонтрагента;
			НовыйКонтрагент.Записать();
			Контрагент = НовыйКонтрагент.Ссылка;
		КонецЕсли;

		// 2. Найти договор у этого контрагента или создать новый
		Договор = Справочники.ДоговорыКонтрагентов.НайтиПоНаименованию(
			СтрокаДанных.НаименованиеДоговора, Истина, , Контрагент);

		Если Договор.Пустая() Тогда
			ДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
		Иначе
			ДоговорОбъект = Договор.ПолучитьОбъект();
		КонецЕсли;

		ДоговорОбъект.Наименование = СтрокаДанных.НаименованиеДоговора;
		ДоговорОбъект.Владелец = Контрагент;
		ДоговорОбъект.Организации = СтрокаДанных.Организация;
		ДоговорОбъект.ВидДоговора = СтрокаДанных.ВидДоговора;
		ДоговорОбъект.ДатаНачала = СтрокаДанных.ДатаНачала;
		ДоговорОбъект.ДатаОкончания = СтрокаДанных.ДатаОкончания;
		ДоговорОбъект.Записать();

	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьФайл(Команда)

	// Если в таблице уже есть строки — спросим пользователя
	Если ТаблицаДанных.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх(
			"Табличная часть уже содержит строки. Очистить и загрузить новые?",
			РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл Excel|*.xlsx";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);

	Если Результат = Неопределено
		Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ПрочитатьФайлНаСервере(Результат.Адрес);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");

	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Очистит платформа
	КонецПопытки;

	ТаблицаДанных.Очистить();

	// Строка 1 — заголовки, данные со строки 2
	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл

		НаименованиеКонтрагента = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст);
		Если ПустаяСтрока(НаименованиеКонтрагента) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.НаименованиеКонтрагента = НаименованиеКонтрагента;
		НоваяСтрока.НаименованиеДоговора = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст);

		НоваяСтрока.ДатаНачала = СтрокаВДату(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 3).Текст));
		НоваяСтрока.ДатаОкончания = СтрокаВДату(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 4).Текст));

		НоваяСтрока.Организация = Справочники.Организации.НайтиПоНаименованию(
			СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 5).Текст));

		ВидДоговораСтрокой = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 6).Текст);
		НоваяСтрока.ВидДоговора = ?(ВидДоговораСтрокой = "С поставщиком",
			Перечисления.ВидыДоговоров.СПоставщиком,
			Перечисления.ВидыДоговоров.СПокупателем);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СтрокаВДату(Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Части = СтрРазделить(Строка, ".");
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции