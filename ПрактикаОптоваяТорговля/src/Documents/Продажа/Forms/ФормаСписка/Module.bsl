#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Правило = Список.УсловноеОформление.Элементы.Добавить();
    Правило.Использование = Истина;

    Правило.Оформление.УстановитьЗначениеПараметра(
        "ЦветТекста", WebЦвета.Серый);

    Условие = Правило.Отбор.Элементы.Добавить(
        Тип("ЭлементОтбораКомпоновкиДанных"));

    Условие.Использование = Истина;
    Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Дата");
    Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше;
    Условие.ПравоеЗначение = ТекущаяДата() - 30 * 24 * 60 * 60;

КонецПроцедуры
#КонецОбласти