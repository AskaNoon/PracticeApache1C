Процедура ОбработкаПроведения(Отказ, Режим)

	// 0. Определяем регистр и вид движения по виду договора
	Если Договор.ВидДоговора = Перечисления.ВидыДоговоров.СПоставщиком Тогда
		ИмяРегистра = "ВзаиморасчётыСПоставщиками";
		ВидДвижения = ВидДвиженияНакопления.Расход;
	ИначеЕсли Договор.ВидДоговора = Перечисления.ВидыДоговоров.СПокупателем Тогда
		ИмяРегистра = "ВзаиморасчётыСПокупателями";
		ВидДвижения = ВидДвиженияНакопления.Приход;
	КонецЕсли;

	Если ВидДвижения = ВидДвиженияНакопления.Расход Тогда

		// 1. Блокировка будет наложена в момент Записать()
		Движения[ИмяРегистра].БлокироватьДляИзменения = Истина;

		// 2. Безусловно формируем расход
		Движение = Движения[ИмяРегистра].Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = Дата;
		Движение.Контрагент = Контрагент;
		Движение.Договор = Договор;
		Движение.Сумма = Сумма;

		// 3. Явно записываем движения в базу
		Движения[ИмяРегистра].Записать();

		// 4. Ищем отрицательные остатки с учётом движений этого документа
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РегОстатки.СуммаОстаток КАК СуммаОстаток
		|ИЗ
		|	РегистрНакопления." + ИмяРегистра + ".Остатки(
		|		&Граница,
		|		Контрагент = &Контрагент
		|		И Договор = &Договор) КАК РегОстатки
		|ГДЕ
		|	РегОстатки.СуммаОстаток < 0";
		Запрос.УстановитьПараметр("Граница", Новый Граница(МоментВремени(), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Договор", Договор);

		// 5. Если нашлись отрицательные остатки, отказ и сообщение
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Отказ = Истина;
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("Сумма списания (%1) превышает остаток задолженности — проведение невозможно", Сумма);
			Сообщение.Поле = "Сумма";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
		КонецЕсли;

	Иначе

		// Приход: контроль не нужен, остаток только растёт
		Движения[ИмяРегистра].Записывать = Истина;
		Движение = Движения[ИмяРегистра].Добавить();
		Движение.ВидДвижения = ВидДвижения;
		Движение.Период = Дата;
		Движение.Контрагент = Контрагент;
		Движение.Договор = Договор;
		Движение.Сумма = Сумма;

	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.Покупка") Тогда
		Основание = ДанныеЗаполнения;
		Контрагент = Основание.Контрагент;
		Договор = Основание.Договор;
		Сумма = Основание.СписокНоменклатуры.Итог("Сумма");
	КонецЕсли;

КонецПроцедуры