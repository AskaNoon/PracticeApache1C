
#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ЗагрузитьИзФайла(Команда)

	// Если табличная часть уже содержит строки — спросим пользователя
	Если Объект.Цены.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх(
			"Табличная часть уже содержит строки. Очистить и загрузить новые?",
			РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл Excel|*.xlsx";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);

	Если Результат = Неопределено
		Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	АдресФайла = Результат.Адрес;
	ЗагрузитьЦеныНаСервере(АдресФайла);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьЦеныНаСервере(АдресФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДвоичныеДанные = Неопределено Тогда
		ВызватьИсключение "Не удалось получить файл из временного хранилища.";
	КонецЕсли;

	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);

	// Временный файл больше не нужен
	УдалитьФайлы(ИмяВременногоФайла);

	Объект.Цены.Очистить();

	// Строка 1 — заголовки, данные начинаются со строки 2
	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл

		НаименованиеНоменклатуры = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст);
		Если ПустаяСтрока(НаименованиеНоменклатуры) Тогда
			Продолжить;
		КонецЕсли;

		ЦенаСтроки = 0;
		Попытка
			ЦенаСтроки = Число(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст));
		Исключение
			ЦенаСтроки = 0;
		КонецПопытки;

		Если Не ЗначениеЗаполнено(ЦенаСтроки) Тогда
			Продолжить;
		КонецЕсли;

		Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(НаименованиеНоменклатуры);
		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			Номенклатура = СоздатьНоменклатуру(НаименованиеНоменклатуры);
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Номенклатура) Тогда
			// Позицию создать не удалось — строку в табличную часть не добавляем
			Продолжить;
		КонецЕсли;

		НоваяСтрока = Объект.Цены.Добавить();
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Цена = ЦенаСтроки;

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СоздатьНоменклатуру(Наименование)

	НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйЭлемент.Наименование = Наименование;

	Попытка
		НовыйЭлемент.Записать();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось создать номенклатуру """ + Наименование + """: " + ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецПопытки;

	Возврат НовыйЭлемент.Ссылка;

КонецФункции

#КонецОбласти
