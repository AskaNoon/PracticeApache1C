&НаКлиенте
Асинх Процедура ЗагрузитьФайл(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл JSON|*.json";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);

	Если Результат = Неопределено
		Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ЗагрузитьРасходыНаСервере(Результат.Адрес);

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьРасходыНаСервере(АдресФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("json");

	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	Чтение = Новый ЧтениеJSON;
	Чтение.ОткрытьФайл(ИмяВременногоФайла, "UTF-8");

	// Истина — читаем объекты JSON в Соответствие, массив — в Массив
	Данные = ПрочитатьJSON(Чтение, Истина);

	Чтение.Закрыть();

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Не удалился — платформа очистит сама
	КонецПопытки;

	Записи = Новый Массив;

	Для Каждого Элемент Из Данные Цикл
		Запись = Новый Структура;
		Запись.Вставить("Месяц", XMLЗначение(Тип("Дата"), Элемент["month"]));
		Запись.Вставить("Статья", Элемент["expenseItem"]);
		Запись.Вставить("Сумма", Число(Элемент["amount"]));
		Записи.Добавить(Запись);
	КонецЦикла;

	ОбработатьЗаписи(Записи);

КонецПроцедуры

&НаСервере
Функция НайтиСтатьюРасходов(Наименование)

	Статья = Справочники.СтатьиРасходов.НайтиПоНаименованию(Наименование, Истина);

	Если Статья.Пустая() Тогда
		ВызватьИсключение "Не найдена статья расходов: """ + Наименование + """";
	КонецЕсли;

	Возврат Статья;

КонецФункции

&НаСервере
Функция НайтиДокументЗаМесяц(Месяц)

	ДатаНачала = НачалоМесяца(Месяц);
	ДатаОкончания = КонецМесяца(Месяц);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КосвенныеРасходы.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КосвенныеРасходы КАК КосвенныеРасходы
	|ГДЕ
	|	КосвенныеРасходы.Месяц МЕЖДУ &НачалоМесяца И &КонецМесяца";
	Запрос.УстановитьПараметр("НачалоМесяца", ДатаНачала);
	Запрос.УстановитьПараметр("КонецМесяца", ДатаОкончания);

	РезультатЗапроса = Запрос.Выполнить();

	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();

	Возврат Выборка.Ссылка;

КонецФункции

&НаСервере
Процедура ОбработатьЗаписи(Записи)

	// Группируем записи по месяцу
	Месяцы = Новый Соответствие;

	Для Каждого ЗаписьРасхода Из Записи Цикл
		Ключ = НачалоМесяца(ЗаписьРасхода.Месяц);
		Список = Месяцы[Ключ];
		Если Список = Неопределено Тогда
			Список = Новый Массив;
			Месяцы.Вставить(Ключ, Список);
		КонецЕсли;
		Список.Добавить(ЗаписьРасхода);
	КонецЦикла;

	Для Каждого КлючИЗначение Из Месяцы Цикл

		МесяцДокумента = КлючИЗначение.Ключ;
		СписокЗаписей = КлючИЗначение.Значение;

		НайденныйДокумент = НайтиДокументЗаМесяц(МесяцДокумента);

		Если НайденныйДокумент = Неопределено Тогда
			ДокументОбъект = Документы.КосвенныеРасходы.СоздатьДокумент();
			ДокументОбъект.Дата = МесяцДокумента;
		Иначе
			ДокументОбъект = НайденныйДокумент.ПолучитьОбъект();
			ДокументОбъект.СписокРасходов.Очистить();
		КонецЕсли;

		ДокументОбъект.Месяц = МесяцДокумента;

		Для Каждого ЗаписьРасхода Из СписокЗаписей Цикл
			Статья = НайтиСтатьюРасходов(ЗаписьРасхода.Статья);
			НоваяСтрока = ДокументОбъект.СписокРасходов.Добавить();
			НоваяСтрока.СтатьяРасходов = Статья;
			НоваяСтрока.Сумма = ЗаписьРасхода.Сумма;
		КонецЦикла;

		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

	КонецЦикла;

КонецПроцедуры