&НаКлиенте
Перем ДлительнаяОперация;

&НаКлиенте
Асинх Процедура ЗагрузитьИзJSON(Команда)

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл JSON|*.json";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога);

	Если Результат = Неопределено Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ДлительнаяОперация = ЗапуститьЗагрузкуНаСервере(Результат.Адрес);

	СтатусОперации = "Выполняется...";
	Прогресс = 0;

	ПодключитьОбработчикОжидания("ПроверитьРезультатЗагрузки", 2);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьРезультатЗагрузки()

	Если ДлительнаяОперация = Неопределено Тогда
		ОтключитьОбработчикОжидания("ПроверитьРезультатЗагрузки");
		Возврат;
	КонецЕсли;

	СостояниеОперации = СостояниеЗадания(ДлительнаяОперация);

	Если СостояниеОперации = "Выполняется" Тогда
		Возврат;
	КонецЕсли;

	ОтключитьОбработчикОжидания("ПроверитьРезультатЗагрузки");
	Прогресс = 100;

	Если СостояниеОперации = "Ошибка" Тогда
		СтатусОперации = "Ошибка при загрузке";
		ПоказатьОповещениеПользователя(ТекстОшибкиЗадания(ДлительнаяОперация.ИдентификаторЗадания));
		Возврат;
	КонецЕсли;

	КоличествоЗаписей = ПолучитьРезультатЗагрузки(ДлительнаяОперация.АдресРезультата);
	СтатусОперации = "Загружено записей: " + Строка(КоличествоЗаписей);

КонецПроцедуры

&НаСервере
Функция ЗапуститьЗагрузкуНаСервере(Знач АдресФайла)

	Результат = Новый Структура;
	Результат.Вставить("ИдентификаторЗадания");
	Результат.Вставить("АдресРезультата");

	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайла);
	Если ДанныеФайла = Неопределено Тогда
		ВызватьИсключение "Не удалось прочитать выбранный файл";
	КонецЕсли;

	ИмяФайла = ПолучитьИмяВременногоФайла("json");
	ДанныеФайла.Записать(ИмяФайла);

	Результат.АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);

	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ИмяФайла);
	ПараметрыЗадания.Добавить(Результат.АдресРезультата);

	ФоновоеЗадание = ФоновыеЗадания.Выполнить(
		"ЗагрузкаКосвенныхРасходов.ЗагрузитьНаСервере",
		ПараметрыЗадания,
		,
		"Загрузка косвенных расходов из JSON");

	Результат.ИдентификаторЗадания = ФоновоеЗадание.УникальныйИдентификатор;

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Функция СостояниеЗадания(Знач Операция)

	Если ТипЗнч(Операция) <> Тип("Структура")
		Или Не Операция.Свойство("ИдентификаторЗадания") Тогда
		Возврат "Ошибка";
	КонецЕсли;

	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(Операция.ИдентификаторЗадания);

	Если ФоновоеЗадание = Неопределено Тогда
		Возврат "Ошибка";
	КонецЕсли;

	Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
		Возврат "Выполняется";
	КонецЕсли;

	Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно
		Или ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Возврат "Ошибка";
	КонецЕсли;

	Возврат "Выполнено";

КонецФункции

&НаСервереБезКонтекста
Функция ТекстОшибкиЗадания(Знач ИдентификаторЗадания)

	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);

	Если ФоновоеЗадание = Неопределено Или ФоновоеЗадание.ИнформацияОбОшибке = Неопределено Тогда
		Возврат "Фоновое задание завершилось с ошибкой";
	КонецЕсли;

	Возврат ОбработкаОшибок.ПодробноеПредставлениеОшибки(ФоновоеЗадание.ИнформацияОбОшибке);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьРезультатЗагрузки(Знач АдресРезультата)

	Возврат ПолучитьИзВременногоХранилища(АдресРезультата);

КонецФункции
