&НаКлиенте
Асинх Процедура ЗагрузитьВБазу(Команда)

	Количество = ПолучитьКоличествоНовыхНаСервере();

	Если Количество.Квартиры > 0 Или Количество.Клиенты > 0 Тогда
		ТекстВопроса = "Будет создано новых квартир: " + Количество.Квартиры
			+ ", новых клиентов: " + Количество.Клиенты + ". Продолжить?";
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ЗагрузитьВБазуНаСервере();

КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоНовыхНаСервере()

	// Считаем уникальные названия, чтобы одна и та же
	// квартира или клиент в нескольких строках не посчитались дважды
	НовыеКвартиры = Новый Соответствие;
	НовыеКлиенты = Новый Соответствие;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		Если Справочники.Квартиры.НайтиПоНаименованию(СтрокаДанных.Квартира, Истина).Пустая() Тогда
			НовыеКвартиры.Вставить(СтрокаДанных.Квартира, Истина);
		КонецЕсли;

		Если Справочники.Клиенты.НайтиПоНаименованию(СтрокаДанных.Клиент, Истина).Пустая() Тогда
			НовыеКлиенты.Вставить(СтрокаДанных.Клиент, Истина);
		КонецЕсли;

	КонецЦикла;

	Возврат Новый Структура("Квартиры, Клиенты", НовыеКвартиры.Количество(), НовыеКлиенты.Количество());

КонецФункции

&НаСервере
Процедура ЗагрузитьВБазуНаСервере()

	ОшибкиЗагрузки = Новый Массив;

	Для Каждого СтрокаДанных Из ТаблицаДанных Цикл

		ВидДоговора = ВидДоговораПоТексту(СтрокаДанных.ВидДоговора);

		Если ВидДоговора.Пустая() Тогда
			ОшибкиЗагрузки.Добавить("«" + СтрокаДанных.НаименованиеДоговора
				+ "»: не распознан вид договора «" + СтрокаДанных.ВидДоговора + "»");
			Продолжить;
		КонецЕсли;

		// 1. Найти или создать квартиру и клиента
		Квартира = НайтиИлиСоздатьЭлемент(Справочники.Квартиры, СтрокаДанных.Квартира);
		Клиент = НайтиИлиСоздатьЭлемент(Справочники.Клиенты, СтрокаДанных.Клиент);

		// 2. Договор: найти по наименованию или создать новый
		Договор = Справочники.Договоры.НайтиПоНаименованию(СтрокаДанных.НаименованиеДоговора, Истина);

		Если Договор.Пустая() Тогда
			ДоговорОбъект = Справочники.Договоры.СоздатьЭлемент();
		Иначе
			ДоговорОбъект = Договор.ПолучитьОбъект();
		КонецЕсли;

		ДоговорОбъект.Наименование = СтрокаДанных.НаименованиеДоговора;
		ДоговорОбъект.Квартира = Квартира;
		ДоговорОбъект.Владелец = Клиент;
		ДоговорОбъект.ВидДоговора = ВидДоговора;
		ДоговорОбъект.ДатаНачала = СтрокаДанных.ДатаНачала;
		ДоговорОбъект.ДатаОкончания = СтрокаДанных.ДатаОкончания;
		ДоговорОбъект.ЦенаЗаСутки = СтрокаДанных.ЦенаЗаСутки;
		ДоговорОбъект.Записать();

	КонецЦикла;

	Если ОшибкиЗагрузки.Количество() > 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не загружены строки:" + Символы.ПС
			+ СтрСоединить(ОшибкиЗагрузки, Символы.ПС);
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВидДоговораПоТексту(Текст)

	Текст = ВРег(СокрЛП(Текст));

	Если Найти(Текст, "ПОКУПАТЕЛ") > 0 Тогда
		Возврат Перечисления.ВидДоговоров.СПокупателем;
	ИначеЕсли Найти(Текст, "СОБСТВЕННИК") > 0 Тогда
		Возврат Перечисления.ВидДоговоров.ССобственником;
	КонецЕсли;

	Возврат Перечисления.ВидДоговоров.ПустаяСсылка();

КонецФункции



&НаСервере
Функция НайтиИлиСоздатьЭлемент(Менеджер, Наименование)

	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);

	Если Ссылка.Пустая() Тогда
		НовыйЭлемент = Менеджер.СоздатьЭлемент();
		НовыйЭлемент.Наименование = Наименование;
		НовыйЭлемент.Записать();
		Ссылка = НовыйЭлемент.Ссылка;
	КонецЕсли;

	Возврат Ссылка;

КонецФункции
&НаКлиенте
Асинх Процедура ЗагрузитьФайл(Команда)

	// Если в таблице уже есть строки — спросим пользователя
	Если ТаблицаДанных.Количество() > 0 Тогда
		Ответ = Ждать ВопросАсинх(
			"Табличная часть уже содержит строки. Очистить и загрузить новые?",
			РежимДиалогаВопрос.ДаНет);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалога.Фильтр = "Файл Excel|*.xlsx";

	Результат = Ждать ПоместитьФайлНаСерверАсинх(, , , ПараметрыДиалога, УникальныйИдентификатор);

	Если Результат = Неопределено
		Или Результат.ПомещениеФайлаОтменено Тогда
		Возврат;
	КонецЕсли;

	ПрочитатьФайлНаСервере(Результат.Адрес);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлНаСервере(АдресФайла)

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");

	ДвоичныеДанные.Записать(ИмяВременногоФайла);

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(ИмяВременногоФайла);

	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		// Очистит платформа
	КонецПопытки;

	ТаблицаДанных.Очистить();

	// Строка 1 — заголовки, данные со строки 2
	Для НомерСтроки = 2 По ТабличныйДокумент.ВысотаТаблицы Цикл

		НазваниеКвартиры = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 1).Текст);
		Если ПустаяСтрока(НазваниеКвартиры) Тогда
			Продолжить;
		КонецЕсли;

		НоваяСтрока = ТаблицаДанных.Добавить();
		НоваяСтрока.Квартира = НазваниеКвартиры;
		НоваяСтрока.Клиент = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 2).Текст);
		НоваяСтрока.НаименованиеДоговора = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 3).Текст);
		НоваяСтрока.ДатаНачала = СтрокаВДату(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 4).Текст));
		НоваяСтрока.ДатаОкончания = СтрокаВДату(СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 5).Текст));

		ЦенаТекст = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 6).Текст);
		ЦенаТекст = СтрЗаменить(ЦенаТекст, " ", "");
		ЦенаТекст = СтрЗаменить(ЦенаТекст, Символы.НПП, "");
		НоваяСтрока.ЦенаЗаСутки = Число(ЦенаТекст);
		НоваяСтрока.ВидДоговора = СокрЛП(ТабличныйДокумент.Область(НомерСтроки, 7).Текст);

	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция СтрокаВДату(Строка)

	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;

	Попытка
		Части = СтрРазделить(Строка, ".");
		Возврат Дата(Число(Части[2]), Число(Части[1]), Число(Части[0]));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;

КонецФункции