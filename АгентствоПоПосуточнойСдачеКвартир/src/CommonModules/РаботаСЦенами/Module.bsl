#Область ПрограммныйИнтерфейс

// Возвращает цену за сутки аренды квартиры на указанную дату.
//
// Параметры:
//  Квартира - СправочникСсылка.Квартиры - квартира, для которой определяется цена.
//  Дата - Дата - дата, на которую определяется цена.
//
// Возвращаемое значение:
//  Число - цена за сутки; 0, если цена не установлена.
//
Функция ПолучитьСтоимостьАренды(Квартира, Дата) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СтоимостьАрендыСрезПоследних.ЦенаЗаСутки КАК ЦенаЗаСутки
		|ИЗ
		|	РегистрСведений.СтоимостьАренды.СрезПоследних(&Дата,
		|		Квартира = &Квартира) КАК СтоимостьАрендыСрезПоследних";

	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Запрос.УстановитьПараметр("Квартира", Квартира);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦенаЗаСутки;
	КонецЕсли;

	Возврат 0;

КонецФункции

#КонецОбласти
