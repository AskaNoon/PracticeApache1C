Процедура ЗагрузитьНаСервере(Знач ИмяФайла, Знач АдресРезультата) Экспорт

	ДанныеJSON = ПрочитатьФайлJSON(ИмяФайла);

	МассивЗаписей = Неопределено;
	Если ТипЗнч(ДанныеJSON) = Тип("Массив") Тогда
		МассивЗаписей = ДанныеJSON;
	ИначеЕсли ТипЗнч(ДанныеJSON) = Тип("Соответствие") Тогда
		МассивЗаписей = ДанныеJSON.Получить("Расходы");
	КонецЕсли;

	Если МассивЗаписей = Неопределено Тогда
		ВызватьИсключение "В файле JSON не найден массив записей о расходах";
	КонецЕсли;

	РасходыПоМесяцам = Новый Соответствие;

	Для Каждого ЭлементЗаписи Из МассивЗаписей Цикл

		МесяцСтрокой = Строка(ЗначениеПоля(ЭлементЗаписи, "Месяц", "month"));
		МесяцДокумента = НачалоМесяца(XMLЗначение(Тип("Дата"), МесяцСтрокой));

		НаименованиеСтатьи = Строка(ЗначениеПоля(ЭлементЗаписи, "Статья", "expenseItem"));
		Статья = Справочники.СтатьиРасходов.НайтиПоНаименованию(НаименованиеСтатьи, Истина);
		Если Статья.Пустая() Тогда
			ВызватьИсключение "Не найдена статья расходов: """ + НаименованиеСтатьи + """";
		КонецЕсли;

		СтрокаРасхода = Новый Структура;
		СтрокаРасхода.Вставить("Статья", Статья);
		СтрокаРасхода.Вставить("Сумма", Число(ЗначениеПоля(ЭлементЗаписи, "Сумма", "amount")));

		СтрокиМесяца = РасходыПоМесяцам[МесяцДокумента];
		Если СтрокиМесяца = Неопределено Тогда
			СтрокиМесяца = Новый Массив;
			РасходыПоМесяцам.Вставить(МесяцДокумента, СтрокиМесяца);
		КонецЕсли;

		СтрокиМесяца.Добавить(СтрокаРасхода);

	КонецЦикла;

	КоличествоЗаписей = 0;

	СписокМесяцев = Новый Массив;
	Для Каждого КлючИЗначение Из РасходыПоМесяцам Цикл
		СписокМесяцев.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;

	ДокументыПоМесяцам = ДокументыЗаМесяцы(СписокМесяцев);

	Для Каждого МесяцИСтроки Из РасходыПоМесяцам Цикл

		МесяцДокумента = МесяцИСтроки.Ключ;
		СтрокиРасходов = МесяцИСтроки.Значение;

		СуществующийДокумент = ДокументыПоМесяцам[МесяцДокумента];

		Если СуществующийДокумент = Неопределено Тогда
			ДокументОбъект = Документы.КосвенныеРасходы.СоздатьДокумент();
			ДокументОбъект.Дата = ТекущаяДатаСеанса();
			ДокументОбъект.Месяц = МесяцДокумента;
		Иначе
			ДокументОбъект = СуществующийДокумент.ПолучитьОбъект();
			ДокументОбъект.СписокРасходов.Очистить();
		КонецЕсли;

		Для Каждого СтрокаРасхода Из СтрокиРасходов Цикл
			НоваяСтрока = ДокументОбъект.СписокРасходов.Добавить();
			НоваяСтрока.СтатьяРасходов = СтрокаРасхода.Статья;
			НоваяСтрока.Сумма = СтрокаРасхода.Сумма;
			КоличествоЗаписей = КоличествоЗаписей + 1;
		КонецЦикла;

		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);

	КонецЦикла;

	ПоместитьВоВременноеХранилище(КоличествоЗаписей, АдресРезультата);

КонецПроцедуры

Функция ПрочитатьФайлJSON(Знач ИмяФайла)

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.ОткрытьФайл(ИмяФайла, "UTF-8");

	ДанныеJSON = ПрочитатьJSON(ЧтениеJSON, Истина);
	ЧтениеJSON.Закрыть();

	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		ЗаписьЖурналаРегистрации("Загрузка косвенных расходов", УровеньЖурналаРегистрации.Информация, , ,
			"Не удалось удалить временный файл " + ИмяФайла);
	КонецПопытки;

	Возврат ДанныеJSON;

КонецФункции

Функция ДокументыЗаМесяцы(Знач СписокМесяцев)

	Результат = Новый Соответствие;

	Если СписокМесяцев.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КосвенныеРасходы.Ссылка КАК Ссылка,
	|	КосвенныеРасходы.Месяц КАК Месяц
	|ИЗ
	|	Документ.КосвенныеРасходы КАК КосвенныеРасходы
	|ГДЕ
	|	КосвенныеРасходы.Месяц В (&Месяцы)
	|	И НЕ КосвенныеРасходы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	КосвенныеРасходы.Дата УБЫВ";
	Запрос.УстановитьПараметр("Месяцы", СписокМесяцев);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МесяцДокумента = НачалоМесяца(Выборка.Месяц);
		Если Результат[МесяцДокумента] = Неопределено Тогда
			Результат.Вставить(МесяцДокумента, Выборка.Ссылка);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ЗначениеПоля(Знач ЭлементЗаписи, Знач ИмяРусское, Знач ИмяАнглийское)

	Значение = Неопределено;

	Если ТипЗнч(ЭлементЗаписи) = Тип("Соответствие") Тогда
		Значение = ЭлементЗаписи.Получить(ИмяРусское);
		Если Значение = Неопределено Тогда
			Значение = ЭлементЗаписи.Получить(ИмяАнглийское);
		КонецЕсли;
	КонецЕсли;

	Если Значение = Неопределено Тогда
		ВызватьИсключение "В записи JSON не найдено поле """ + ИмяРусское + """ (""" + ИмяАнглийское + """)";
	КонецЕсли;

	Возврат Значение;

КонецФункции
