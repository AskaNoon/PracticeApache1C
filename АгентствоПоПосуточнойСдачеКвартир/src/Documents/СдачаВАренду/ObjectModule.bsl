#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
#Область ОбработчикиСобытий
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	Ответственный = Пользователи.ТекущийПользователь();
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)

    Ответственный = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)

	ПроверитьСоответствиеДатыДокументаПериодуДоговора(Отказ);

КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)

	ПроверитьДоговорСобственника(Отказ);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// регистр Продажи
	Движения.Продажи.Записывать = Истина;
	Движение = Движения.Продажи.Добавить();
	Движение.Период = Дата;
	Движение.Клиент = Клиент;
	Движение.Договор = Договор;
	Движение.Квартира = Квартира;
	Движение.Сумма = Стоимость;

	// регистр СтоимостьАренды
	Движения.СтоимостьАренды.Записывать = Истина;
	Движение = Движения.СтоимостьАренды.Добавить();
	Движение.Период = Дата;
	Движение.Квартира = Квартира;
	Движение.ЦенаЗаСутки = ЦенаЗаСутки;


КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьСоответствиеДатыДокументаПериодуДоговора(Отказ)

	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат;
	КонецЕсли;

	Если Договор.ДатаНачала > Дата Или КонецДня(Договор.ДатаОкончания) < Дата Тогда
		Отказ = Истина;
		ШаблонСообщения = "Дата документа должна быть в периоде действия договора (с %1 по %2)";
		Сообщение = Новый СообщениеПользователю;
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Поле = "Договор";
		Сообщение.Текст = СтрШаблон(ШаблонСообщения,
			Формат(Договор.ДатаНачала, "ДЛФ=DD;"),
			Формат(Договор.ДатаОкончания, "ДЛФ=DD;"));
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьДоговорСобственника(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Квартира = &Квартира
		|	И Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидДоговоров.ССобственником)
		|	И Договоры.ДатаНачала <= &ДатаНачала
		|	И Договоры.ДатаОкончания >= &ДатаОкончания";

	Запрос.УстановитьПараметр("Квартира", Квартира);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ДатаОкончания);

	Если Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		Сообщение = Новый СообщениеПользователю;
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Поле = "Квартира";
		Сообщение.Текст = "На выбранные даты нет действующего договора с собственником квартиры.";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры


#КонецОбласти
