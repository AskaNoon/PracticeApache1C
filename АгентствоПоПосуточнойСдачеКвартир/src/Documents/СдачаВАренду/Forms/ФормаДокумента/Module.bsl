#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// Цену уже сохранённого документа не перезаписываем ценой из регистра.
	Если Не ЗначениеЗаполнено(Объект.ЦенаЗаСутки) Тогда
		Объект.ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(Объект.Квартира, Объект.ДатаНачала);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КвартираПриИзменении(Элемент)
	Объект.ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(Объект.Квартира, Объект.ДатаНачала);
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	Объект.ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(Объект.Квартира, Объект.ДатаНачала);
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	Объект.ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(Объект.Квартира, Объект.ДатаНачала);
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуЗаСуткиНаСервере(Квартира, ДатаНачала)

	Если Не ЗначениеЗаполнено(Квартира) Или Не ЗначениеЗаполнено(ДатаНачала) Тогда
		Возврат 0;
	КонецЕсли;

	Возврат РаботаСЦенами.ПолучитьСтоимостьАренды(Квартира, ДатаНачала);

КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимость()

	Если Не ЗначениеЗаполнено(Объект.ДатаНачала)
		Или Не ЗначениеЗаполнено(Объект.ДатаОкончания)
		Или НачалоДня(Объект.ДатаОкончания) < НачалоДня(Объект.ДатаНачала) Тогда
		Объект.Стоимость = 0;
		Возврат;
	КонецЕсли;

	КоличествоДней = (НачалоДня(Объект.ДатаОкончания) - НачалоДня(Объект.ДатаНачала)) / 86400 + 1;
	Объект.Стоимость = Объект.ЦенаЗаСутки * КоличествоДней;

КонецПроцедуры

#КонецОбласти
