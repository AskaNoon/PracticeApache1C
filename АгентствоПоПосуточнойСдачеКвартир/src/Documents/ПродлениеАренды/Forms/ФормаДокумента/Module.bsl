#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(ТекущийОбъект.Договор);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ЦенаЗаСутки = ПолучитьЦенуЗаСуткиНаСервере(Объект.Договор);
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	РассчитатьСтоимость();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуЗаСуткиНаСервере(Договор)
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Договоры.ЦенаЗаСутки КАК ЦенаЗаСутки
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	Договоры.Ссылка = &Договор";
	Запрос.УстановитьПараметр("Договор", Договор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ЦенаЗаСутки;
	КонецЕсли;
	Возврат 0;
КонецФункции

&НаКлиенте
Процедура РассчитатьСтоимость()
	Если Не ЗначениеЗаполнено(Объект.ДатаНачала)
		Или Не ЗначениеЗаполнено(Объект.ДатаОкончания)
		Или НачалоДня(Объект.ДатаОкончания) < НачалоДня(Объект.ДатаНачала) Тогда
		Объект.Стоимость = 0;
		Возврат;
	КонецЕсли;
	КоличествоДней = (НачалоДня(Объект.ДатаОкончания) - НачалоДня(Объект.ДатаНачала)) / 86400 + 1;
	Объект.Стоимость = ЦенаЗаСутки * КоличествоДней;
КонецПроцедуры

#КонецОбласти