Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;
	Поля.Добавить("Наименование");
	Поля.Добавить("ДатаНачала");
	Поля.Добавить("ДатаОкончания");

КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;

	Если Данные.ДатаНачала = Дата(1, 1, 1)
		Или Данные.ДатаОкончания = Дата(1, 1, 1) Тогда
		Представление = Строка(Данные.Наименование);
		Возврат;
	КонецЕсли;

	// Проверяем, является ли период ровно одним целым месяцем: с 1-го числа по последний день этого же месяца
	НачалоПервогоДня = НачалоМесяца(Данные.ДатаНачала);
	КонецПоследнегоДня = КонецДня(КонецМесяца(Данные.ДатаНачала));

	Если Данные.ДатаНачала = НачалоПервогоДня
		И НачалоДня(Данные.ДатаОкончания) = НачалоДня(КонецПоследнегоДня)
		И НачалоМесяца(Данные.ДатаОкончания) = НачалоПервогоДня Тогда

		ТекстМесяца = Формат(Данные.ДатаНачала, "ДФ='MMMM yyyy'");
		Представление = СтрШаблон("%1 (%2)", Данные.Наименование, ТекстМесяца);
	Иначе
		ПредставлениеПериода = СтрШаблон("с %1 по %2",
			Формат(Данные.ДатаНачала, "ДЛФ=D"),
			Формат(Данные.ДатаОкончания, "ДЛФ=D"));
		Представление = СтрШаблон("%1 (%2)", Данные.Наименование, ПредставлениеПериода);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка) Экспорт

	СтандартнаяОбработка = Ложь;
	ТекущаяДата = НачалоДня(ТекущаяДатаСеанса());

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Договоры.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Договоры.Ссылка) КАК Представление
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.ДатаНачала <= &ТекущаяДата
	|	И Договоры.ДатаОкончания >= &ТекущаяДата";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата);

	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();

	ДанныеВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		ДанныеВыбора.Добавить(Выборка.Ссылка, Выборка.Представление);
	КонецЦикла;

КонецПроцедуры